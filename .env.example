PORT=3001
# Supabase Postgres Connection String (Transaction Pooler URI, port 6543)
DATABASE_URL=

# Supabase Auth (Multi-user Email + Google OAuth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fallback local SQLite path when DATABASE_URL is empty
STUDY_OS_DB_PATH=./data/study-os.sqlite

# Optional defaults
WEBHOOK_SECRET=study-os-dev-secret
SCHEDULER_INTERVAL_MS=60000
