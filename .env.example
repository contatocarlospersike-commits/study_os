PORT=3001
# Supabase Postgres Connection String (Session/Transaction Pooler URI)
# Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Fallback local SQLite path when DATABASE_URL is empty
STUDY_OS_DB_PATH=./data/study-os.sqlite

# Optional: n8n Webhook URL for automated study reminders & Auto-Quiz dispatch
N8N_WEBHOOK_URL=
# Optional: HMAC secret to sign outbound webhooks (X-StudyOS-Signature header)
WEBHOOK_SECRET=study-os-dev-secret
# Optional: WhatsApp Cloud API credentials (if dispatching directly without n8n)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=
# Spaced repetition scheduler check interval in milliseconds (standalone local mode)
SCHEDULER_INTERVAL_MS=60000
